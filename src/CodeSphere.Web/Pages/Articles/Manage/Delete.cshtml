@page "{id:int}"
@model CodeSphere.Web.Pages.Articles.Manage.DeleteModel
@{
    ViewData["Title"] = "Delete Article";
}

<h1>Delete Article</h1>

@if (Model.Article != null)
{
    <div class="alert alert-warning">Are you sure you want to delete this article? This cannot be undone.</div>

    <dl class="row">
        <dt class="col-sm-2">Title</dt>
        <dd class="col-sm-10">@Model.Article.Title</dd>
        <dt class="col-sm-2">Category</dt>
        <dd class="col-sm-10">@Model.Article.CategoryName</dd>
        <dt class="col-sm-2">Comments</dt>
        <dd class="col-sm-10">@Model.Article.CommentCount</dd>
    </dl>

    <form method="post">
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Confirm Delete</button>
        <a asp-page="/Articles/Manage/Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
}
