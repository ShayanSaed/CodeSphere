@page
@model CodeSphere.Web.Pages.Reports.UserActivityModel
@{
    ViewData["Title"] = "User Activity Report";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 mb-3 no-print">
    <h1 class="mb-0">User Activity Report</h1>
    <div class="d-flex flex-wrap gap-2">
        <button onclick="window.print()" class="btn btn-outline-secondary"><i class="bi bi-printer"></i> Print</button>
        <a asp-page-handler="ExportPdf" class="btn btn-outline-danger"><i class="bi bi-file-earmark-pdf"></i> PDF</a>
        <a asp-page-handler="ExportExcel" class="btn btn-outline-success"><i class="bi bi-file-earmark-excel"></i> Excel</a>
        <a asp-page="/Reports/Trending" class="btn btn-outline-primary">&larr; Trending Articles Report</a>
    </div>
</div>

<p class="text-muted">Mirrors the original <code>UserActivityView</code> SQL view: total articles, comments and reactions per user, plus follower counts.</p>

<div class="report-table-wrapper">
    <table class="table table-striped table-hover mb-0">
        <thead>
            <tr>
                <th>Username</th>
                <th>Full Name</th>
                <th>Articles</th>
                <th>Comments</th>
                <th>Reactions</th>
                <th>Followers</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr>
                    <td class="text-nowrap"><a asp-page="/Users/Details" asp-route-id="@r.UserID">@r.Username</a></td>
                    <td class="text-nowrap">@(r.FullName ?? "-")</td>
                    <td>@r.TotalArticles</td>
                    <td>@r.TotalComments</td>
                    <td>@r.TotalReactions</td>
                    <td>@r.TotalFollowers</td>
                </tr>
            }
        </tbody>
    </table>
</div>
