@page
@model CodeSphere.Web.Pages.Reports.TrendingModel
@{
    ViewData["Title"] = "Trending Articles Report";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 mb-3 no-print">
    <h1 class="mb-0">Trending Articles Report</h1>
    <div class="d-flex flex-wrap gap-2">
        <button onclick="window.print()" class="btn btn-outline-secondary"><i class="bi bi-printer"></i> Print</button>
        <a asp-page-handler="ExportPdf" class="btn btn-outline-danger"><i class="bi bi-file-earmark-pdf"></i> PDF</a>
        <a asp-page-handler="ExportExcel" class="btn btn-outline-success"><i class="bi bi-file-earmark-excel"></i> Excel</a>
        <a asp-page="/Reports/UserActivity" class="btn btn-outline-primary">User Activity Report &rarr;</a>
    </div>
</div>

<p class="text-muted">Ranked by engagement score = views + (comments &times; 3) + (reactions &times; 2), mirroring the original <code>TrendingArticlesView</code> SQL view.</p>

<div class="report-table-wrapper">
    <table class="table table-striped table-hover mb-0">
        <thead>
            <tr>
                <th>#</th>
                <th>Title</th>
                <th>Author</th>
                <th>Category</th>
                <th>Views</th>
                <th>Comments</th>
                <th>Reactions</th>
                <th>Engagement Score</th>
            </tr>
        </thead>
        <tbody>
            @{ var rank = 1; }
            @foreach (var r in Model.Rows)
            {
                <tr>
                    <td>@rank</td>
                    <td class="text-nowrap"><a asp-page="/Articles/Details" asp-route-id="@r.ArticleID">@r.Title</a></td>
                    <td class="text-nowrap">@r.Author</td>
                    <td class="text-nowrap">@r.CategoryName</td>
                    <td>@r.ViewCount</td>
                    <td>@r.CommentCount</td>
                    <td>@r.ReactionCount</td>
                    <td><strong>@r.EngagementScore</strong></td>
                </tr>
                rank++;
            }
        </tbody>
    </table>
</div>
