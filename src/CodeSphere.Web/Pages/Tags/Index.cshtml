@page
@model CodeSphere.Web.Pages.Tags.IndexModel
@{
    ViewData["Title"] = "Tags";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 mb-3">
    <h1 class="mb-0">Tags</h1>
    @if (User.IsInRole("Admin"))
    {
        <a class="btn btn-cs-accent" asp-page="/Tags/Create"><i class="bi bi-plus-circle"></i> New Tag</a>
    }
</div>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-6">
        <input type="text" name="Keyword" value="@Model.Keyword" class="form-control" placeholder="Search tags by name..." />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-cs-accent w-100"><i class="bi bi-search"></i> Search</button>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.Keyword))
    {
        <div class="col-md-2">
            <a asp-page="/Tags/Index" class="btn btn-outline-secondary w-100">Clear</a>
        </div>
    }
</form>

@if (!Model.Tags.Any())
{
    <p class="text-muted">No tags match your search.</p>
}

<div class="d-flex flex-wrap gap-2">
    @foreach (var t in Model.Tags)
    {
        <div class="card p-2 px-3 d-flex flex-row align-items-center gap-2">
            <a asp-page="/Index" asp-route-TagId="@t.TagID" class="text-decoration-none">#@t.TagName <span class="text-muted">(@t.ArticleCount)</span></a>
            @if (User.IsInRole("Admin"))
            {
                <a class="btn btn-sm btn-outline-secondary" asp-page="/Tags/Edit" asp-route-id="@t.TagID"><i class="bi bi-pencil"></i></a>
                <a class="btn btn-sm btn-outline-danger" asp-page="/Tags/Delete" asp-route-id="@t.TagID"><i class="bi bi-trash"></i></a>
            }
        </div>
    }
</div>

<partial name="Shared/_Pagination" model="Model.Pagination" />
