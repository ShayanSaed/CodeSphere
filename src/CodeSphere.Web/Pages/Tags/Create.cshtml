@page
@model CodeSphere.Web.Pages.Tags.CreateModel
@{
    ViewData["Title"] = "New Tag";
}
<h1>New Tag</h1>
<form method="post" class="mt-3 col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Input.TagName" class="form-label"></label>
        <input asp-for="Input.TagName" class="form-control" />
        <span asp-validation-for="Input.TagName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Description" class="form-label"></label>
        <textarea asp-for="Input.Description" class="form-control" rows="2"></textarea>
    </div>
    <button type="submit" class="btn btn-cs-accent">Create</button>
    <a asp-page="/Tags/Index" class="btn btn-outline-secondary">Cancel</a>
</form>
