@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <script>
        // Applied as early as possible (before first paint) to avoid a
        // flash of the wrong theme. The toggle button's own click handler
        // lives in site.js; this just restores whatever was saved last.
        (function () {
            try {
                var saved = localStorage.getItem('cs-theme');
                var theme = saved || (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
                document.documentElement.setAttribute('data-bs-theme', theme);
            } catch (e) { /* ignore */ }
        })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CodeSphere</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/print.css" media="print" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark cs-navbar sticky-top no-print">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-area="" asp-page="/Index"><i class="bi bi-code-slash"></i> CodeSphere</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navMenu">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-page="/Index">Articles</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Categories/Index">Categories</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Tags/Index">Tags</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Users/Index">Community</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Reports/Trending">Reports</a></li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Dashboard/Index">Dashboard</a></li>
                        }
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Articles/Manage/Index">My Articles</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Bookmarks/Index">Bookmarks</a></li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-lg-center">
                        <li class="nav-item me-lg-2">
                            <button type="button" class="btn btn-sm btn-outline-light" data-theme-toggle title="Toggle dark / light theme">
                                <i class="bi bi-moon-stars"></i>
                            </button>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Articles/Manage/Create"><i class="bi bi-plus-circle"></i> Write</a></li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle"></i> @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-page="/Users/Details" asp-route-id="@User.FindFirstValue(ClaimTypes.NameIdentifier)"><i class="bi bi-person"></i> My Profile</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form id="logoutForm" method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index")">
                                            <button type="submit" class="dropdown-item">Logout</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Login</a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Register">Register</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-4">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show no-print" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show no-print" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        <main>
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted no-print">
        <div class="container py-3 text-center">
            &copy; @DateTime.Now.Year - CodeSphere
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.20.1/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
