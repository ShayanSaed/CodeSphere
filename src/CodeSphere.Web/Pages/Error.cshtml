@page
@model CodeSphere.Web.Pages.ErrorModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger"><i class="bi bi-exclamation-octagon"></i> Something went wrong</h1>
<p>An unexpected error occurred while processing your request. It has been logged.</p>
@if (Model.ShowRequestId)
{
    <p class="text-muted small">Request ID: <code>@Model.RequestId</code></p>
}
<a asp-page="/Index" class="btn btn-cs-accent">Back to Home</a>
