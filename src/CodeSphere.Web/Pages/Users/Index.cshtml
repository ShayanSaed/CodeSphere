@page
@model CodeSphere.Web.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Community";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Community</h1>
</div>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-6">
        <input type="text" name="Keyword" value="@Model.Keyword" class="form-control" placeholder="Search by username or full name..." />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-cs-accent w-100"><i class="bi bi-search"></i> Search</button>
    </div>
</form>

@if (!Model.Users.Items.Any())
{
    <p class="text-muted">No users match your search.</p>
}

<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3">
    @foreach (var u in Model.Users.Items)
    {
        <div class="col">
            <a asp-page="/Users/Details" asp-route-id="@u.UserId" class="text-decoration-none text-reset">
                <div class="card article-card h-100 p-3 text-center">
                    @if (!string.IsNullOrWhiteSpace(u.ProfileImageURL))
                    {
                        <img src="@u.ProfileImageURL" alt="@u.Username's avatar" class="rounded-circle mx-auto mb-2" width="72" height="72" style="object-fit:cover;" />
                    }
                    else
                    {
                        <i class="bi bi-person-circle mx-auto mb-2" style="font-size:72px;color:var(--cs-primary);"></i>
                    }
                    <h6 class="mb-0">@(u.FullName ?? u.Username)</h6>
                    <p class="text-muted small mb-2">@@@u.Username</p>
                    <div class="d-flex justify-content-center gap-3 text-muted small">
                        @if (!string.IsNullOrWhiteSpace(u.Country))
                        {
                            <span><i class="bi bi-geo-alt"></i> @u.Country</span>
                        }
                        <span><i class="bi bi-journal-text"></i> @u.ArticleCount</span>
                        <span><i class="bi bi-people"></i> @u.FollowerCount</span>
                    </div>
                </div>
            </a>
        </div>
    }
</div>

<partial name="Shared/_Pagination" model="Model.Pagination" />
